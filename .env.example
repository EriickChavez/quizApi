# ==============================================
# QUIZAPI - CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ==============================================
# Copia este archivo como .env y configura tus valores

# ==============================================
# CONFIGURACIÓN DEL SERVIDOR
# ==============================================
PORT=3000
NODE_ENV=development

# ==============================================
# BASE DE DATOS - MONGODB
# ==============================================
# URL de conexión a MongoDB
# Desarrollo local: mongodb://localhost:27017/quizapi
# Producción: mongodb://user:password@host:port/database
MONGO_URI=mongodb://localhost:27017/quizapi

# ==============================================
# AUTENTICACIÓN JWT
# ==============================================
# Clave secreta para firmar tokens JWT (¡DEBE ser segura en producción!)
JWT_SECRET=tu_clave_super_secreta_aqui_cambiala_en_produccion

# Tiempo de expiración de los tokens (ejemplos: 1h, 24h, 7d, 30d)
JWT_EXPIRES_IN=7d

# ==============================================
# BASE DE DATOS - MYSQL (OPCIONAL)
# ==============================================
# Configuración para MySQL (para uso futuro)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=tu_password_mysql
MYSQL_DATABASE=quizapi

# ==============================================
# CONFIGURACIÓN DE LOGGING
# ==============================================
# Nivel de logging (error, warn, info, debug)
LOG_LEVEL=info

# ==============================================
# CONFIGURACIÓN DE SEGURIDAD
# ==============================================
# Configuración de CORS (dominios permitidos, separados por coma)
# Desarrollo: * (todos los dominios)
# Producción: https://tudominio.com,https://www.tudominio.com
CORS_ORIGIN=*

# ==============================================
# CONFIGURACIÓN DE RATE LIMITING
# ==============================================
# Número máximo de requests por ventana de tiempo
RATE_LIMIT_MAX=100

# Ventana de tiempo en minutos
RATE_LIMIT_WINDOW=15

# ==============================================
# CONFIGURACIÓN DE EMAIL (FUTURO)
# ==============================================
# Para funcionalidades futuras como reset de password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu_email@gmail.com
# SMTP_PASS=tu_app_password

# ==============================================
# CONFIGURACIÓN DE ARCHIVOS (FUTURO)
# ==============================================
# Para subida de avatares, imágenes, etc.
# UPLOAD_DIR=uploads
# MAX_FILE_SIZE=5242880  # 5MB en bytes

# ==============================================
# CONFIGURACIÓN DE CACHE (FUTURO)
# ==============================================
# Para Redis u otro sistema de cache
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=tu_redis_password

# ==============================================
# CONFIGURACIÓN DE MONITOREO (FUTURO)
# ==============================================
# Para servicios como Sentry, New Relic, etc.
# SENTRY_DSN=tu_sentry_dsn
# NEW_RELIC_LICENSE_KEY=tu_new_relic_key

# ==============================================
# NOTAS IMPORTANTES
# ==============================================
# 1. NUNCA commitees el archivo .env al repositorio
# 2. Usa valores seguros para JWT_SECRET en producción
# 3. Configura CORS_ORIGIN apropiadamente en producción
# 4. Cambia las credenciales por defecto de la base de datos
# 5. Considera usar servicios como AWS Secrets Manager o similar en producción
